# Google Cloud project with "Places API (New)" enabled
GOOGLE_PLACES_API_KEY=

# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional — only needed for automatic sending. Leave blank to run in
# "draft only, I'll send manually" mode.
COMPOSIO_API_KEY=
# User ID shown on the Gmail connection in your Composio dashboard (defaults to "default" if omitted)
COMPOSIO_USER_ID=default

# Your name/business, used to sign outreach messages
YOUR_NAME=
YOUR_BUSINESS_NAME=
YOUR_CONTACT_EMAIL=
